[Icon Theme]
Name=Etesian
Comment=N9-style app icons and Etesian-coloured folders and file types (see CREDITS); everything else from Breeze
Inherits=breeze-dark,breeze,hicolor
DisplayDepth=32
DesktopDefault=48
ToolbarDefault=22
MainToolbarDefault=22
SmallDefault=16
PanelDefault=48
DialogDefault=32
FollowsColorScheme=true
Directories=breeze/actions/16,breeze/actions/22,breeze/actions/24,breeze/actions/32,breeze/status/16,breeze/status/22,breeze/status/24,breeze/status/32,breeze/status/64,apps/32,apps/48,apps/64,apps/128,apps/172,apps/scalable,actions/symbolic,scalable/places,scalable/mimetypes,scalable/devices,scalable/status,16x16/places,16x16/mimetypes,16x16/devices

