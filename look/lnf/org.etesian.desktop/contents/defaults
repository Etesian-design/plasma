[kdeglobals][General]
ColorScheme=Etesian

[kdeglobals][Icons]
Theme=Etesian

[kdeglobals][KDE]
widgetStyle=Etesian

[plasmarc][Theme]
name=etesian

# (no library or theme here: install.sh picks the decoration, the native one or its Aurorae stand-in; with one here too, applying
# this look and feel raced install.sh and could leave KWin on Aurorae)
[kwinrc][org.kde.kdecoration2]
ButtonsOnLeft=M
ButtonsOnRight=IAX
BorderSize=None
BorderSizeAuto=false

[kcminputrc][Mouse]
cursorTheme=breeze_cursors

[ksplashrc][KSplash]
Theme=org.etesian.desktop
Engine=KSplashQML

[kcminputrc][Mouse]
cursorTheme=Etesian-cursors
